<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- The monitor allocates very little, so the background (concurrent)
         garbage collector and its reserved memory are not needed. -->
    <gcConcurrent enabled="false" />
  </runtime>
</configuration>
